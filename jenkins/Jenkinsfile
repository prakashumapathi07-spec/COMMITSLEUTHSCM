// CommitSleuth SCM Declarative CI Pipeline
// Course: ISWE403L — Software Configuration Management
// Integrates Git, Jenkins, Maven, Python Failure Attribution, and SCM Status Accounting

def runCmd(cmd) {
    if (isUnix()) {
        sh cmd
    } else {
        bat cmd
    }
}

pipeline {
    agent any

    tools {
        // Uses default Maven and JDK if configured in Jenkins Global Tool Configuration
        maven 'Maven 3.9'
        jdk 'JDK 17'
    }

    environment {
        // Auto-resolves relative to current workspace if CS_DB is not explicitly injected
        CS_DB = "${WORKSPACE}/database/commitsleuth.db"
        PYTHONIOENCODING = "utf-8"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '25'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout & SCM Identification') {
            steps {
                echo '=== Stage 1: Checkout Source and Verify Configuration Baseline ==='
                checkout scm
                script {
                    def commitHash = ""
                    if (isUnix()) {
                        commitHash = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    } else {
                        commitHash = bat(returnStdout: true, script: '@git rev-parse --short HEAD').trim()
                    }
                    echo "Checking out commit: ${commitHash} on branch: ${env.GIT_BRANCH ?: 'local'}"
                }
            }
        }

        stage('Environment & Configuration Verification') {
            steps {
                echo '=== Stage 2: SCM Environment Verification ==='
                script {
                    runCmd('python --version')
                    runCmd('mvn -version')
                }
            }
        }

        stage('Maven Dependency Resolution') {
            steps {
                echo '=== Stage 3: Maven Dependency Resolution ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml dependency:resolve')
                }
            }
        }

        stage('Maven Clean & Compile') {
            steps {
                echo '=== Stage 4: Clean Compilation of Java Application ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml clean compile > build.log 2>&1')
                }
            }
        }

        stage('Unit Testing & Test Report') {
            steps {
                echo '=== Stage 5: Execute JUnit Tests with Maven Surefire ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml test >> build.log 2>&1')
                }
            }
        }

        stage('Publish Test Evidence') {
            steps {
                echo '=== Stage 6: Publish Surefire Test Reports ==='
                junit testResults: '**/maven/target/surefire-reports/*.xml', allowEmptyResults: true
            }
        }

        stage('Promote to Testing') {
            when {
                expression { env.GIT_BRANCH ==~ /.*(develop|release).*/ }
            }
            steps {
                echo '=== Stage 7A: SCM Promotion Gate (Development -> Testing) ==='
                script {
                    runCmd('python analyzer/promote.py --item "CommitSleuth Suite" --from Development --to Testing --approver CCB --tests-passed')
                }
            }
        }

        stage('Promote to Production') {
            when {
                expression { env.GIT_BRANCH ==~ /.*main.*/ }
            }
            steps {
                echo '=== Stage 7B: SCM Promotion Gate (Testing -> Production) ==='
                script {
                    runCmd('python analyzer/promote.py --item "CommitSleuth Suite" --from Testing --to Production --approver "Faculty Guide / CCB" --tests-passed --tag v1.0.0')
                }
            }
        }
    }

    post {
        success {
            echo '=== Pipeline Execution Succeeded: Recording Status Accounting ==='
            script {
                runCmd("python analyzer/record_build.py --result SUCCESS --build ${env.BUILD_NUMBER} --branch \"${env.GIT_BRANCH ?: 'main'}\"")
            }
        }
        failure {
            echo '=== Pipeline Execution Failed: Triggering CommitSleuth Failure Attribution ==='
            script {
                runCmd("python analyzer/record_build.py --result FAILURE --build ${env.BUILD_NUMBER} --log build.log --branch \"${env.GIT_BRANCH ?: 'main'}\"")
            }
        }
        always {
            echo '=== Archiving SCM Evidence & Build Logs ==='
            archiveArtifacts artifacts: 'build.log, reports/**', allowEmptyArchive: true
        }
    }
}
