
/*
 * CommitSleuth SCM Declarative CI Pipeline
 * Course: ISWE403L — Software Configuration Management
 * Integrates Git, Jenkins, Maven, Python Failure Attribution,
 * and SCM Status Accounting.
 */

def runCmd(cmd) {
    if (isUnix()) {
        sh cmd
    } else {
        bat cmd
    }
}

pipeline {
    agent any

    tools {
        // Must match the names configured in Jenkins > Tools.
        maven 'Maven'
        jdk 'jdk-23'
    }

    environment {
        CS_DB = "${WORKSPACE}/database/commitsleuth.db"
        PYTHONIOENCODING = 'utf-8'
        PYTHON_EXE = 'C:\\Users\\PRAKASH\\AppData\\Local\\Programs\\Python\\Python312\\python.exe'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '25'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout & SCM Identification') {
            steps {
                echo '=== Stage 1: Checkout Source and Verify Configuration Baseline ==='
                checkout scm

                script {
                    def commitHash

                    if (isUnix()) {
                        commitHash = sh(
                            returnStdout: true,
                            script: 'git rev-parse --short HEAD'
                        ).trim()
                    } else {
                        commitHash = bat(
                            returnStdout: true,
                            script: '@git rev-parse --short HEAD'
                        ).trim()
                    }

                    echo "Checking out commit: ${commitHash}"
                    echo "Branch: ${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'local'}"
                }
            }
        }

        stage('Environment & Configuration Verification') {
            steps {
                echo '=== Stage 2: Verify Java, Maven and Python ==='
                script {
                    runCmd('java -version')
                    runCmd('mvn -version')

                    if (isUnix()) {
                        runCmd('python3 --version')
                    } else {
                        runCmd('"%PYTHON_EXE%" --version')
                    }
                }
            }
        }

        stage('Maven Dependency Resolution') {
            steps {
                echo '=== Stage 3: Maven Dependency Resolution ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml dependency:resolve')
                }
            }
        }

        stage('Maven Clean & Compile') {
            steps {
                echo '=== Stage 4: Clean Compilation ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml clean compile')
                }
            }
        }

        stage('Unit Testing & Test Report') {
            steps {
                echo '=== Stage 5: Execute JUnit Tests ==='
                script {
                    runCmd('mvn -B -f maven/pom.xml test')
                }
            }
        }

        stage('Publish Test Evidence') {
            steps {
                echo '=== Stage 6: Publish Surefire Test Reports ==='
                junit(
                    testResults: 'maven/target/surefire-reports/*.xml',
                    allowEmptyResults: true
                )
            }
        }

        stage('Promote to Testing') {
            when {
                expression {
                    (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '') ==~
                        /.*(develop|release).*/
                }
            }
            steps {
                echo '=== Stage 7A: Development to Testing ==='
                script {
                    if (isUnix()) {
                        runCmd(
                            'python3 analyzer/promote.py --item "CommitSleuth Suite" --from Development --to Testing --approver CCB --tests-passed'
                        )
                    } else {
                        runCmd(
                            '"%PYTHON_EXE%" analyzer/promote.py --item "CommitSleuth Suite" --from Development --to Testing --approver CCB --tests-passed'
                        )
                    }
                }
            }
        }

        stage('Promote to Production') {
            when {
                expression {
                    (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '') ==~
                        /.*main.*/
                }
            }
            steps {
                echo '=== Stage 7B: Testing to Production ==='
                script {
                    if (isUnix()) {
                        runCmd(
                            'python3 analyzer/promote.py --item "CommitSleuth Suite" --from Testing --to Production --approver "Faculty Guide / CCB" --tests-passed --tag v1.0.0'
                        )
                    } else {
                        runCmd(
                            '"%PYTHON_EXE%" analyzer/promote.py --item "CommitSleuth Suite" --from Testing --to Production --approver "Faculty Guide / CCB" --tests-passed --tag v1.0.0'
                        )
                    }
                }
            }
        }
    }

    post {
        success {
            echo '=== Build Succeeded: Recording SCM Status ==='
            script {
                if (isUnix()) {
                    runCmd(
                        "python3 analyzer/record_build.py --result SUCCESS --build ${env.BUILD_NUMBER} --branch \"${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main'}\""
                    )
                } else {
                    runCmd(
                        "\"%PYTHON_EXE%\" analyzer/record_build.py --result SUCCESS --build ${env.BUILD_NUMBER} --branch \"${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main'}\""
                    )
                }
            }
        }

        failure {
            echo '=== Build Failed: Recording Failure Information ==='
            script {
                if (isUnix()) {
                    runCmd(
                        "python3 analyzer/record_build.py --result FAILURE --build ${env.BUILD_NUMBER} --log build.log --branch \"${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main'}\""
                    )
                } else {
                    runCmd(
                        "\"%PYTHON_EXE%\" analyzer/record_build.py --result FAILURE --build ${env.BUILD_NUMBER} --log build.log --branch \"${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main'}\""
                    )
                }
            }
        }

        always {
            echo '=== Archiving SCM Evidence and Build Logs ==='
            archiveArtifacts(
                artifacts: 'build.log, reports/**',
                allowEmptyArchive: true
            )
        }
    }
}
```
